# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Secret key for server-side Paystack verification & HMAC-SHA512 webhooks.
PAYSTACK_SECRET_KEY=""

# VITE_PAYSTACK_PUBLIC_KEY: Public key for Paystack inline checkout (optional in test mode).
VITE_PAYSTACK_PUBLIC_KEY=""

# WHATSAPP_PROVIDER: meta_cloud | termii | twilio (for WhatsApp integration later)
WHATSAPP_PROVIDER="meta_cloud"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# RESEND: Transactional Email Notifications (Customer + Admin Alerts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Raw.hairs <onboarding@resend.dev>"
ADMIN_ALERT_EMAIL="boopuddin64@gmail.com"

# SUPABASE: Database (Postgres) + Authentication
# Public (exposed to Vite client bundle)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only secrets (never expose in client code)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL=""
